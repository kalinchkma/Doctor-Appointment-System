# Publicly exposed only by Docker Compose; keep actual secrets in .env.
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_MONGODB_USERNAME=payload_root
PAYLOAD_MONGODB_PASSWORD=replace-with-a-payload-db-password
PAYLOAD_DATABASE_URI=mongodb://payload_root:replace-with-a-payload-db-password@mongodb:27017/doctor_app?authSource=admin

# Dedicated Atlas Local instance used only by the Go RAG service for vector data.
RAG_MONGODB_USERNAME=rag_root
RAG_MONGODB_PASSWORD=replace-with-a-rag-vector-db-password
RAG_DATABASE_URI=mongodb://rag_root:replace-with-a-rag-vector-db-password@vector-mongodb:27017/rag_vectors?authSource=admin&replicaSet=rs0
RAG_DATABASE_NAME=rag_vectors
RAG_SERVICE_URL=http://rag:8080
RAG_INTERNAL_SECRET=replace-with-another-long-random-secret

# Used by the browser app in local development (never add provider credentials here).
VITE_PAYLOAD_URL=http://localhost:3000

# Reserved for the RAG service. Do not commit actual keys.
LLM_API_KEY=
EMBEDDING_API_KEY=
