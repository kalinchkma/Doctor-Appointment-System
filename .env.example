# Copy to .env and replace every placeholder. .env is gitignored and must never be committed.
# Generate secrets with: openssl rand -hex 32

# --- MongoDB -----------------------------------------------------------------
# A single Atlas Local instance holds two logical databases: doctor_app and rag_vectors.
#
# The set name is "mongodb" because the Compose service pins that hostname, and Atlas
# Local derives the replica set name from it. Passing ?replicaSet=mongodb is what makes
# Payload enable transactions; the adapter silently falls back to non-transactional
# writes when the client has no explicit replicaSet.
#
# Running the CMS on the host instead of in Compose? The host cannot resolve "mongodb",
# so use ?directConnection=true there. Booking stays correct either way: the endpoint
# compensates manually when no transaction is available.
MONGODB_USERNAME=root
MONGODB_PASSWORD=replace-with-a-database-password

# --- Payload CMS -------------------------------------------------------------
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_DATABASE_URI=mongodb://root:replace-with-a-database-password@mongodb:27017/doctor_app?authSource=admin&replicaSet=mongodb
PAYLOAD_PUBLIC_URL=http://localhost:3000
# Behind nginx (LAN or EC2) omit :3000, e.g. http://192.168.0.102 or http://<elastic-ip>
# Then rebuild the APK with the same value in apps/mobile/.env VITE_PAYLOAD_URL.
# Reachable from the RAG container. On the host this is localhost; in Compose it is http://cms:3000.
PAYLOAD_INTERNAL_URL=http://cms:3000
MOBILE_ORIGIN=http://localhost:5173

# --- Payload to Go RAG (internal network only, ADR-006) ----------------------
RAG_SERVICE_URL=http://rag:8080
RAG_INTERNAL_SECRET=replace-with-another-long-random-secret

# Chat sessions (multi-turn history). Compose uses redis://redis:6379;
# host-side CMS should use redis://127.0.0.1:6379.
REDIS_URL=redis://redis:6379

# --- Go RAG service ----------------------------------------------------------
RAG_DATABASE_URI=mongodb://root:replace-with-a-database-password@mongodb:27017/rag_vectors?authSource=admin&replicaSet=mongodb
RAG_DATABASE_NAME=rag_vectors
RAG_MAX_CONCURRENCY=4

# Sufficiency gates. These are starting guesses; calibrate them against the real PDFs
# and record the resulting confusion matrix in the README before submitting.
RAG_MIN_SCORE=0.50
RAG_STRONG_SCORE=0.58
RAG_MIN_CHUNKS=1
RAG_MIN_COVERAGE=0.25
# Per-request chat budget inside the Go service (retrieval + LLM). Raise if Ollama cold-starts time out.
# deepseek-r1 is slower than llama3.2; 180s leaves room for first-token reasoning.
RAG_CHAT_TIMEOUT_SEC=180
# Background PDF ingest (download + extract + embed all chunks). Large files need several minutes.
RAG_INGEST_TIMEOUT_SEC=900

# Packed Ollama in Compose (recommended on EC2). Payload uses this when RAG Settings
# leave the base URL blank. Defaults: chat llama3.2, embeddings nomic-embed-text.
# Host-only Ollama: http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://ollama:11434/v1
EMBEDDING_DIMENSIONS=768

# --- File storage ------------------------------------------------------------
# local (default): Docker volumes cms_media / cms_knowledge_files
# s3: set S3_* below   |   azure: set AZURE_* below
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=
# AZURE_STORAGE_ACCOUNT_BASEURL=
# AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false

# --- Mobile ------------------------------------------------------------------
# VITE_* values are compiled into the client bundle and are public by definition.
# Never put a credential behind this prefix.
VITE_PAYLOAD_URL=http://localhost:3000
