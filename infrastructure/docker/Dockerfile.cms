# Node major is pinned to match .nvmrc so the image and local development agree.
FROM node:22-alpine AS deps
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/payload/package.json apps/payload/package.json
COPY apps/mobile/package.json apps/mobile/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS seed
WORKDIR /workspace
COPY apps/payload apps/payload
COPY docs/knowledge docs/knowledge
WORKDIR /workspace/apps/payload
CMD ["pnpm", "seed"]

FROM deps AS build
WORKDIR /workspace
COPY apps/payload apps/payload
WORKDIR /workspace/apps/payload
# Next inlines PAYLOAD_PUBLIC_URL into the admin client (serverURL / CSRF). Must match
# the public nginx origin (no :3000) or login 200s then bounces back to /admin/login.
ARG PAYLOAD_PUBLIC_URL=http://localhost:3000
ENV PAYLOAD_PUBLIC_URL=$PAYLOAD_PUBLIC_URL
RUN pnpm build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app \
  && mkdir -p /app/apps/payload/media /app/apps/payload/knowledge-files \
  && chown -R app:app /app
COPY --from=build --chown=app:app /workspace/apps/payload/.next/standalone ./
COPY --from=build --chown=app:app /workspace/apps/payload/.next/static ./apps/payload/.next/static
COPY --from=build --chown=app:app /workspace/apps/payload/public ./apps/payload/public
USER app
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=8 --start-period=40s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/access').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "apps/payload/server.js"]
