FROM golang:1.26-alpine AS build
WORKDIR /src
COPY services/rag/go.mod services/rag/go.sum* ./
RUN go mod download
COPY services/rag ./
RUN CGO_ENABLED=0 go build -o /rag ./cmd/server
FROM gcr.io/distroless/static-debian12
COPY --from=build /rag /rag
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/rag"]
